{
  "name": "geo-data-direction",
  "private": true,
  "version": "0.1.0",
  "description": "Editor de trayectos KML/KMZ, orquestador y centro de control para revisar y ordenar rutas de transporte",
  "license": "MIT",
  "author": "LuvazAng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuvazAng/geo-data-direction.git"
  },
  "bugs": {
    "url": "https://github.com/LuvazAng/geo-data-direction/issues"
  },
  "homepage": "https://github.com/LuvazAng/geo-data-direction#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "kml",
    "kmz",
    "transporte",
    "rutas",
    "morelos",
    "mapas"
  ],
  "type": "module",
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "vite --open",
    "build": "npm run typecheck:web && vite build",
    "preview": "vite preview",
    "orquestar": "tsx src/orchestrator/cli/cli.ts",
    "centro": "tsx src/orchestrator/server/index.ts",
    "colonias": "tsx src/orchestrator/cli/colonias-cli.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:web": "tsc -p tsconfig.json",
    "typecheck:orq": "tsc -p tsconfig.node.json",
    "check": "npm run typecheck:orq && npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "7zip-bin": "^5.2.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
