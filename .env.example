# Copia este archivo como .env y quita el # de lo que necesites. Todo es opcional.
# Qué datos van en cada carpeta y de dónde bajarlos: data/README.md

# Carpeta con los datos del orquestador. Por omisión: ./data
#GEODATA_DIR=/ruta/a/mis/datos

# Sólo si alguna carpeta no está dentro de GEODATA_DIR con el nombre esperado
# (entre paréntesis, dónde se busca si no se define):
#RUTAS_TRABAJO_DIR=      # salida del orquestador   (<GEODATA_DIR>/RUTAS_ORQUESTADOR)
#RUTAS_EXISTENTES_DIR=   # rutas ya clasificadas    (<GEODATA_DIR>/RUTAS)
#INEGI_DIR=              # Marco Geoestadístico     (<GEODATA_DIR>/inegi/conjunto_de_datos)
#COLONIAS_DIR=           # colonias del INE         (<GEODATA_DIR>/INE_BGD_2025/17_morelos)

# Otros
#OLLAMA_URL=http://127.0.0.1:11434
#CENTRO_PORT=5198
